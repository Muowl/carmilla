{
  "name": "carmilla",
  "displayName": "Carmilla",
  "description": "A dark theme family with wine, amethyst and moonstone-blue backgrounds, warm syntax accents and mauve comments.",
  "version": "1.7.0",
  "publisher": "muowl",
  "license": "MIT",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.70.0",
    "node": ">=22"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "theme",
    "color theme",
    "dark",
    "dark theme",
    "pink",
    "purple",
    "violet",
    "amethyst",
    "teal",
    "vampire",
    "boudoir",
    "blue",
    "moonstone"
  ],
  "galleryBanner": {
    "color": "#2E1B2D",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Muowl/carmilla.git"
  },
  "bugs": {
    "url": "https://github.com/Muowl/carmilla/issues"
  },
  "homepage": "https://muowl.dev/themes/carmilla/",
  "contributes": {
    "themes": [
      {
        "label": "Carmilla",
        "uiTheme": "vs-dark",
        "path": "./carmilla.json"
      },
      {
        "label": "Carmilla Amethyst",
        "uiTheme": "vs-dark",
        "path": "./carmilla-amethyst.json"
      },
      {
        "label": "Carmilla Moonstone",
        "uiTheme": "vs-dark",
        "path": "./carmilla-moonstone.json"
      }
    ]
  },
  "scripts": {
    "generate": "node ../../scripts/generate.mjs",
    "check": "node ../../scripts/generate.mjs --check",
    "test": "npm run check && node --test ../../tests/*.test.mjs",
    "preview": "npm run generate && node ../../scripts/preview.mjs --capture",
    "package": "npm run generate && npm test && vsce package --no-dependencies",
    "publish": "npm run generate && npm test && vsce publish --no-dependencies",
    "test:showcase": "npm run check && node ../../scripts/preview.mjs",
    "colors": "node ../../scripts/color-metrics.mjs",
    "brand": "node ../../scripts/export-icon.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@iarna/toml": "2.2.5",
    "@vscode/vsce": "4.0.0",
    "playwright": "1.64.0",
    "vscode-oniguruma": "2.0.1",
    "vscode-textmate": "9.3.2"
  }
}
