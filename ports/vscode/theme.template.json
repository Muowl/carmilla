  "semanticTokenColors": {
    "class": "@colors.verdigris",
    "interface": "@colors.verdigris",
    "struct": "@colors.verdigris",
    "enum": "@colors.verdigris",
    "type": "@colors.verdigris",
    "typeParameter": "@colors.verdigris",
    "namespace": "@colors.verdigris",
    "function": "@colors.absinthe",
    "method": "@colors.absinthe",
    "decorator": "@colors.peach-velvet",
    "macro": "@colors.carmine",
    "keyword": "@colors.carmine",
    "variable": "@colors.pearl",
    "parameter": "@colors.pearl",
    "property": "@colors.pearl",
    "operator": "@colors.pearl",
    "enumMember": "@colors.peach-velvet",
    "number": "@colors.peach-velvet",
    "string": "@colors.champagne",
    "comment": {
      "foreground": "@colors.ash-mauve",
      "fontStyle": "italic"
    },
    "variable.defaultLibrary": {
      "foreground": "@colors.wisteria",
      "fontStyle": "italic"
    }
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "@colors.ash-mauve",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator.new",
        "storage",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "@colors.carmine"
      }
    },
    {
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "@colors.pearl"
      }
    },
    {
      "scope": [
        "keyword.operator.new",
        "keyword.operator.expression"
      ],
      "settings": {
        "foreground": "@colors.carmine"
      }
    },
    {
      "scope": [
        "variable.language",
        "constant.language",
        "variable.language.this",
        "variable.language.super"
      ],
      "settings": {
        "foreground": "@colors.wisteria",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.other.inherited-class",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "@colors.verdigris"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call.generic"
      ],
      "settings": {
        "foreground": "@colors.absinthe"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "@colors.champagne"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language.boolean"
      ],
      "settings": {
        "foreground": "@colors.peach-velvet",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal",
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "@colors.pomegranate"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other",
        "variable.parameter"
      ],
      "settings": {
        "foreground": "@colors.pearl"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "@colors.carmine"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "@colors.absinthe",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "meta.embedded",
        "source.groovy.embedded"
      ],
      "settings": {
        "foreground": "@colors.pearl"
      }
    },
    {
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "foreground": "@colors.carmine",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "@colors.peach-velvet",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "@colors.wisteria",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code"
      ],
      "settings": {
        "foreground": "@colors.champagne"
      }
    },
    {
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "@colors.ash-mauve",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "@colors.absinthe"
      }
    },
    {
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "@colors.pomegranate"
      }
    },
    {
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "@colors.verdigris",
        "fontStyle": "underline"
      }
    }
  ]
}
