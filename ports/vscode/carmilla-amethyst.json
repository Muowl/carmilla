  "semanticTokenColors": {
    "class": "#5ED0D8",
    "interface": "#5ED0D8",
    "struct": "#5ED0D8",
    "enum": "#5ED0D8",
    "type": "#5ED0D8",
    "typeParameter": "#5ED0D8",
    "namespace": "#5ED0D8",
    "function": "#7AE0A6",
    "method": "#7AE0A6",
    "decorator": "#FFAE8A",
    "macro": "#C474D3",
    "keyword": "#C474D3",
    "variable": "#F5EADA",
    "parameter": "#F5EADA",
    "property": "#F5EADA",
    "operator": "#F5EADA",
    "enumMember": "#FFAE8A",
    "number": "#FFAE8A",
    "string": "#EDD795",
    "comment": { "foreground": "#9E83A4", "fontStyle": "italic" },
    "variable.defaultLibrary": { "foreground": "#D5A6FF", "fontStyle": "italic" }
  },
  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "foreground": "#9E83A4",
        "fontStyle": "italic"
      }
    },
    {
      "scope": ["keyword", "keyword.control", "keyword.operator.new", "storage", "storage.type", "storage.modifier"],
      "settings": {
        "foreground": "#C474D3"
      }
    },
    {
      "scope": ["variable.language", "constant.language", "variable.language.this", "variable.language.super"],
      "settings": {
        "foreground": "#D5A6FF",
        "fontStyle": "italic"
      }
    },
    {
      "scope": ["entity.name.type", "entity.name.class", "entity.other.inherited-class", "support.class", "support.type"],
      "settings": {
        "foreground": "#5ED0D8"
      }
    },
    {
      "scope": ["entity.name.function", "support.function", "meta.function-call.generic"],
      "settings": {
        "foreground": "#7AE0A6"
      }
    },
    {
      "scope": ["string", "string.quoted", "string.template", "punctuation.definition.string"],
      "settings": {
        "foreground": "#EDD795"
      }
    },
    {
      "scope": ["constant.numeric", "constant.language.boolean", "constant.language.null", "constant.language.undefined"],
      "settings": {
        "foreground": "#FFAE8A"
      }
    },
    {
      "scope": ["invalid", "invalid.illegal", "invalid.deprecated"],
      "settings": {
        "foreground": "#E84B6E"
      }
    },
    {
      "scope": ["variable", "variable.other", "variable.parameter"],
      "settings": {
        "foreground": "#F5EADA"
      }
    },
    {
      "scope": ["entity.name.tag", "punctuation.definition.tag"],
      "settings": {
        "foreground": "#C474D3"
      }
    },
    {
      "scope": ["entity.other.attribute-name"],
      "settings": {
        "foreground": "#7AE0A6",
        "fontStyle": "italic"
      }
    },
    {
      "scope": ["meta.embedded", "source.groovy.embedded"],
      "settings": {
        "foreground": "#F5EADA"
      }
    },
    {
      "scope": ["markup.heading"],
      "settings": {
        "foreground": "#C474D3",
        "fontStyle": "bold"
      }
    },
    {
      "scope": ["markup.bold"],
      "settings": {
        "foreground": "#FFAE8A",
        "fontStyle": "bold"
      }
    },
    {
      "scope": ["markup.italic"],
      "settings": {
        "foreground": "#D5A6FF",
        "fontStyle": "italic"
      }
    },
    {
      "scope": ["markup.inline.raw", "markup.fenced_code"],
      "settings": {
        "foreground": "#EDD795"
      }
    },
    {
      "scope": ["markup.quote"],
      "settings": {
        "foreground": "#9E83A4",
        "fontStyle": "italic"
      }
    },
    {
      "scope": ["markup.inserted"],
      "settings": {
        "foreground": "#7AE0A6"
      }
    },
    {
      "scope": ["markup.deleted"],
      "settings": {
        "foreground": "#E84B6E"
      }
    },
    {
      "scope": ["markup.underline.link", "string.other.link"],
      "settings": {
        "foreground": "#5ED0D8",
        "fontStyle": "underline"
      }
    }
  ]
}
