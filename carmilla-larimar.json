  "semanticTokenColors": {
    "class": "#86A8FF",
    "interface": "#86A8FF",
    "struct": "#86A8FF",
    "enum": "#86A8FF",
    "type": "#86A8FF",
    "typeParameter": "#86A8FF",
    "namespace": "#86A8FF",
    "function": "#57DB86",
    "method": "#57DB86",
    "decorator": "#EEA98F",
    "macro": "#2CD3CE",
    "keyword": "#2CD3CE",
    "variable": "#E6E9F3",
    "parameter": "#E6E9F3",
    "property": "#E6E9F3",
    "operator": "#E6E9F3",
    "enumMember": "#EEA98F",
    "number": "#EEA98F",
    "string": "#D8C79C",
    "comment": { "foreground": "#74839E", "fontStyle": "italic" },
    "variable.defaultLibrary": { "foreground": "#C9A6F2", "fontStyle": "italic" }
  },
  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "foreground": "#74839E",
        "fontStyle": "italic"
      }
    },
    {
      "scope": ["keyword", "keyword.control", "keyword.operator.new", "storage", "storage.type", "storage.modifier"],
      "settings": {
        "foreground": "#2CD3CE"
      }
    },
    {
      "scope": ["variable.language", "constant.language", "variable.language.this", "variable.language.super"],
      "settings": {
        "foreground": "#C9A6F2",
        "fontStyle": "italic"
      }
    },
    {
      "scope": ["entity.name.type", "entity.name.class", "entity.other.inherited-class", "support.class", "support.type"],
      "settings": {
        "foreground": "#86A8FF"
      }
    },
    {
      "scope": ["entity.name.function", "support.function", "meta.function-call.generic"],
      "settings": {
        "foreground": "#57DB86"
      }
    },
    {
      "scope": ["string", "string.quoted", "string.template", "punctuation.definition.string"],
      "settings": {
        "foreground": "#D8C79C"
      }
    },
    {
      "scope": ["constant.numeric", "constant.language.boolean", "constant.language.null", "constant.language.undefined"],
      "settings": {
        "foreground": "#EEA98F"
      }
    },
    {
      "scope": ["invalid", "invalid.illegal", "invalid.deprecated"],
      "settings": {
        "foreground": "#F0576E"
      }
    },
    {
      "scope": ["variable", "variable.other", "variable.parameter"],
      "settings": {
        "foreground": "#E6E9F3"
      }
    },
    {
      "scope": ["entity.name.tag", "punctuation.definition.tag"],
      "settings": {
        "foreground": "#2CD3CE"
      }
    },
    {
      "scope": ["entity.other.attribute-name"],
      "settings": {
        "foreground": "#57DB86",
        "fontStyle": "italic"
      }
    },
    {
      "scope": ["meta.embedded", "source.groovy.embedded"],
      "settings": {
        "foreground": "#E6E9F3"
      }
    },
    {
      "scope": ["markup.heading"],
      "settings": {
        "foreground": "#2CD3CE",
        "fontStyle": "bold"
      }
    },
    {
      "scope": ["markup.bold"],
      "settings": {
        "foreground": "#EEA98F",
        "fontStyle": "bold"
      }
    },
    {
      "scope": ["markup.italic"],
      "settings": {
        "foreground": "#C9A6F2",
        "fontStyle": "italic"
      }
    },
    {
      "scope": ["markup.inline.raw", "markup.fenced_code"],
      "settings": {
        "foreground": "#D8C79C"
      }
    },
    {
      "scope": ["markup.quote"],
      "settings": {
        "foreground": "#74839E",
        "fontStyle": "italic"
      }
    },
    {
      "scope": ["markup.inserted"],
      "settings": {
        "foreground": "#57DB86"
      }
    },
    {
      "scope": ["markup.deleted"],
      "settings": {
        "foreground": "#F0576E"
      }
    },
    {
      "scope": ["markup.underline.link", "string.other.link"],
      "settings": {
        "foreground": "#86A8FF",
        "fontStyle": "underline"
      }
    }
  ]
}
